<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="task"
    MinSize="550 450"
    SetSize="750 500">
    <BoxContainer Orientation="Vertical">
        <Button
                        Name="UpdateTasksButton"
                        Text="Update"
                        TextAlign="Center">
        </Button>
        <BoxContainer Orientation="Horizontal">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="Название" HorizontalExpand="True" Margin="20 20 20 20" HorizontalAlignment="Center"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="Описание" HorizontalExpand="True" Margin="20 20 20 20" HorizontalAlignment="Center"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="Статус" HorizontalExpand="True" Margin="20 20 20 20" MinWidth="200" HorizontalAlignment="Center"/>
            </BoxContainer>
        </BoxContainer>
        <PanelContainer VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer
                    Name="TaskList"
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    RectClipContent="True"
                    MinHeight="50">
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
