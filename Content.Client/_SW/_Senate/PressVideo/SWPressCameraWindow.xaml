<DefaultWindow xmlns="https://spacestation14.io" Title="Камера прессы" SetSize="600 450" MinSize="550 420">
  <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
    <Label Text="Тема эфира" />
    <LineEdit Name="Topic" PlaceHolder="Введите тему (до 120 символов)" />
    <Label Name="Status" Text="Эфир выключен" />
    <Button Name="StartButton" Text="Начать эфир" />
    <Button Name="StopButton" Text="Завершить эфир" Disabled="True" />
    <Label Text="Речь обрабатывает настроенный TTS-сервис, возможно внешний." /><Label Text="Текст может сохраниться в журналах игры и сервиса" /><Label Text="или в кэше сервиса." /><Label Name="SoundStatus" Text="Звук недоступен" /><CheckBox Name="SpeakerConsent" Disabled="True" Text="Разрешаю передачу моей речи" /><Label Name="ConsentStatus" Text="Передача вашей речи выключена" />
  </BoxContainer>
</DefaultWindow>
