<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client._SW.GlobalWar.UI"
               Title="{Loc 'sw-global-war-travel-title'}"
               MinSize="760 460" SetSize="900 540">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <RichTextLabel Name="Status" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="ZoomOut" Text="−" />
            <Button Name="ZoomIn" Text="+" />
            <Label Name="Zoom" Text="100%" MinWidth="50" />
            <Button Name="ResetView" Text="{Loc 'sw-global-war-travel-reset-view'}" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="12">
            <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                <ui:SWGlobalWarMapControl Name="Map" HorizontalExpand="True" VerticalExpand="True" />
            </PanelContainer>
            <BoxContainer Orientation="Vertical" MinWidth="260" MaxWidth="300" SeparationOverride="8">
                <Label Text="{Loc 'sw-global-war-travel-planet-info'}" />
                <RichTextLabel Name="SelectionHint" Text="{Loc 'sw-global-war-travel-select-planet'}" />
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="PlanetInfo" Orientation="Vertical" SeparationOverride="10" HorizontalExpand="True" Visible="False">
                        <RichTextLabel Name="PlanetName" />
                        <RichTextLabel Name="PlanetDescription" />
                        <RichTextLabel Name="HyperspaceTime" />
                        <RichTextLabel Name="Connections" />
                        <RichTextLabel Name="Availability" />
                        <Button Name="Travel" Text="{Loc 'sw-global-war-travel-jump'}" Disabled="True" />
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
