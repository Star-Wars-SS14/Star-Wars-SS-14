<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="task"
    MinSize="550 450"
    SetSize="750 500">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label Text="taskname" HorizontalExpand="True" />
            <Label Text="taskdesc" HorizontalExpand="True" />
            <Label Text="taskstatus" HorizontalExpand="True" />
            <Button
                        Name="UpdateTasksButton"
                        Text="Update"
                        TextAlign="Center">
            </Button>
        </BoxContainer>

        <PanelContainer VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer
                    Name="TaskList"
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    RectClipContent="True"
                    MinHeight="50">
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
