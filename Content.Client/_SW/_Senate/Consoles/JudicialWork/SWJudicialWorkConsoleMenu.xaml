<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:senate="clr-namespace:Content.Client._SW._Senate"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Рабочая консоль Верховного Суда"
    SetSize="1000 720"
    MinSize="780 660">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="14 10" SeparationOverride="0">
                    <senate:SWConsoleSeal Margin="0 0 12 0" />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="2">
                        <Label Name="HeaderNetwork" Text="РЕСПУБЛИКА / ГОЛОНЕТ" />
                        <Label Name="HeaderTitle" HorizontalExpand="True" ClipText="True" />
                    </BoxContainer>
                    <Label Name="HeaderClock" Margin="12 0 0 0" VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Name="StatusStrip" Orientation="Horizontal" Margin="12 6" />
            <PanelContainer Name="TabBarPanel">
                <WrapContainer Name="TabBar" Margin="6 4" />
            </PanelContainer>
            <BoxContainer Name="ContentHost" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="CaseTab" Orientation="Vertical" Margin="10" HorizontalExpand="True" VerticalExpand="True">
                    <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Name="CaseList" Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Name="RegistryTab" Orientation="Vertical" Margin="10" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Name="RegistryList" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" />
                </BoxContainer>
                <BoxContainer Name="LawsTab" Orientation="Vertical" Margin="10" HorizontalExpand="True" VerticalExpand="True">
                    <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Name="LawsList" Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Name="BenchTab" Orientation="Vertical" Margin="10" HorizontalExpand="True" VerticalExpand="True">
                    <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Name="BenchList" Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
