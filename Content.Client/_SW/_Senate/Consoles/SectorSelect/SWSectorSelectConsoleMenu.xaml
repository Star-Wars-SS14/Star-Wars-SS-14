<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:senate="clr-namespace:Content.Client._SW._Senate"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:sector="clr-namespace:Content.Client._SW._Senate.Consoles.SectorSelect"
    Title="Представительство секторов" MinSize="640 460" SetSize="1100 780">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <sector:SWSectorSelectLayout HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="14 8" SeparationOverride="0">
                    <TextureRect Name="RepublicSeal" SetSize="48 48" Stretch="KeepAspectCentered" CanShrink="True" Margin="0 0 12 0" />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="2">
                        <Label Name="HeaderNetwork" Text="СЕНАТ РЕСПУБЛИКИ / РЕЕСТР СЕКТОРОВ" />
                        <Label Name="HeaderTitle" Text="Выбор представительства" ClipText="True" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
            <sector:SWSectorColumns HorizontalExpand="True" VerticalExpand="True" Margin="12 8" LeftFraction="0.32" Gap="12">
                <PanelContainer Name="CataloguePanel"><BoxContainer Orientation="Vertical" SeparationOverride="5">
                    <LineEdit Name="Search" PlaceHolder="Поиск секторов" HorizontalExpand="True" />
                    <CheckBox Name="FreeOnly" Text="Только свободные" Pressed="True" />
                    <Label Name="FreeCount" />
                    <Button Name="MySector" Text="Мой сектор" Visible="False" />
                    <ScrollContainer Name="ListScroll" HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                        <BoxContainer Name="SectorList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
                    </ScrollContainer>
                </BoxContainer></PanelContainer>
                <PanelContainer Name="DossierPanel" HorizontalExpand="True" VerticalExpand="True"><ScrollContainer Name="DetailScroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10">
                        <sector:SWSectorColumns HorizontalExpand="True" Gap="14" LeftFraction="0.40">
                            <BoxContainer Name="DetailIntro" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="5" />
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="3">
                                <sector:SWSectorMiniMap Name="SectorMap" HorizontalExpand="True" />
                                <BoxContainer Name="MapCaption" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="3" />
                            </BoxContainer>
                        </sector:SWSectorColumns>
                        <BoxContainer Name="Detail" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10" />
                        <sector:SWSectorColumns HorizontalExpand="True" Gap="16" LeftFraction="0.50">
                            <BoxContainer Name="Infrastructure" Orientation="Vertical" HorizontalExpand="True" />
                            <BoxContainer Name="Representative" Orientation="Vertical" HorizontalExpand="True" />
                        </sector:SWSectorColumns>
                    </BoxContainer>
                </ScrollContainer></PanelContainer>
            </sector:SWSectorColumns>
            <sector:SWSectorColumns Name="Footer" Margin="12 0 12 10" Gap="12" RightWidth="210">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="10">
                    <sector:SWSectorCardIcon />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="2">
                        <Label Name="CardCaption" Text="КАРТА СЕНАТОРА" />
                        <BoxContainer Name="FooterText" Orientation="Vertical" HorizontalExpand="True" />
                    </BoxContainer>
                </BoxContainer>
                <sector:SWSectorClaimButton Name="ClaimButton" Text="Занять место" VerticalAlignment="Center" />
            </sector:SWSectorColumns>
        </sector:SWSectorSelectLayout>
    </PanelContainer>
</controls:FancyWindow>
