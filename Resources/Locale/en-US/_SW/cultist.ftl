sw-cultist-role-name = Cultist
sw-cultist-role-description = Secretly complete the cult's shared objective and ensure at least one cultist survives.
sw-cultist-objective-issuer = Cult
sw-cultist-objective-unavailable = No main objective could be assigned. The cult cannot win.
sw-cultist-objective-sword = Obtain the specific lightsaber belonging to {$owner} ({$item}). A living cultist must have it in their possession at round end.
sw-cultist-objective-id-card = Obtain {$owner}’s personal ID card ({$item}). A living cultist must have the card in their possession at round end.
sw-cultist-objective-kill = Ensure {$target}'s specific body is dead at the end of the round, or destroyed by a confirmed gibbing.
sw-cultist-objective-survive = Ensure at least one cultist survives to the end of the round.
sw-cultist-partner = Your ally is {$partner}.
sw-cultist-alone = You are acting alone.
sw-cultist-briefing =
    You are a cultist. {$partner}
    {$objective}
    At least one cultist must survive. A yellow lightsaber will be placed discreetly in your inventory; if there is no room, make space in a pocket or bag.
sw-cultist-roundend-success = The cult completed its objectives.
sw-cultist-roundend-failure = The cult failed its objectives.

sw-cultist-test-usage = Usage: swcultisttest <kill|item> <target NetEntity> <player> [second player]
sw-cultist-test-invalid-round-or-count = An active round and one or two players are required.
sw-cultist-test-rule-unavailable = Exactly one active ordinary SW cultist rule is required.
sw-cultist-test-already-assigned = Cultists or their main objective are already assigned and cannot be replaced.
sw-cultist-test-duplicate = Specify different players.
sw-cultist-test-invalid-player = Player {$player} must control a living character with an eligible ordinary job.
sw-cultist-test-invalid-target = Invalid target: specify a living commander or Force user's body, that Force user's specific lightsaber, or a verified personal command ID card.
sw-cultist-test-selection-unavailable = The cultist selection template is unavailable.
sw-cultist-test-not-allowed = Player {$player} cannot be assigned: check job restrictions and existing antagonist roles.
sw-cultist-test-assignment-failed = Could not assign everyone. Players assigned: {$count}; they retain the selected shared objective.
sw-cultist-test-no-player = Player {$player} was not found among connected sessions.
sw-cultist-test-success = Cultists assigned: {$count}. No random selection will occur later this round.

sw-cultist-test-pending = Players assigned: {$count}. Assignment was partial or objective publication is still recovering; repeating this command is blocked.
sw-cultist-test-uncertain = Assignment may have partially mutated state. Confirmed cultists: {$count}. Reassignment and victory are blocked; inspect the logs and roles.

sw-cultist-roundend-completed = completed
sw-cultist-roundend-not-completed = not completed
sw-cultist-roundend-survived = At least one cultist survived.
sw-cultist-roundend-none-survived = No cultists survived.
