<ui:SWTerminalWindow
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._SW.UserInterface"
    Title="{Loc 'sw-task-console-title'}"
    MinSize="440 280"
    SetSize="520 400">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Name="FactionName" StyleClasses="SWTermValue" HorizontalExpand="True" ClipText="True" />
            <Label Name="Summary" StyleClasses="SWTermText" />
        </BoxContainer>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" ReserveScrollbarSpace="True">
            <BoxContainer Name="TaskList" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</ui:SWTerminalWindow>
