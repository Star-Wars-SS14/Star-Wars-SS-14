<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:viewport="clr-namespace:Content.Client.Viewport"
    Title="Голонет · прямой эфир" MinSize="740 540" SetSize="900 650">
  <PanelContainer Name="RootPanel">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
      <PanelContainer Name="HeaderPanel"><RichTextLabel Name="Details" Margin="10 6" /></PanelContainer>
      <viewport:ScalingViewport Name="CameraView" HorizontalExpand="True" VerticalExpand="True"
                                MinSize="400 260" MouseFilter="Ignore" />
      <Label Text="РЕЧЬ В ЭФИРЕ" />
      <ScrollContainer HScrollEnabled="False" MinHeight="100" MaxHeight="150">
        <RichTextLabel Name="SpeechText" HorizontalExpand="True" />
      </ScrollContainer>
    </BoxContainer>
  </PanelContainer>
</controls:FancyWindow>
