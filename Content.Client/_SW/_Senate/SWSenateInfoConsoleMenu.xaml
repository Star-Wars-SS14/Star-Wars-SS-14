<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Информационная консоль Сената"
    MinSize="520 520">
    <TabContainer Name="Tabs" VerticalExpand="True" HorizontalExpand="True">
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" Margin="8">
            <BoxContainer Name="SectorList" Orientation="Vertical" />
        </ScrollContainer>
        <BoxContainer Name="LeadershipTab" Orientation="Vertical" Margin="12">
            <Label Text="Руководство Республики" StyleClasses="LabelHeading" Margin="0 0 0 8" />
            <RichTextLabel Name="ChancellorLabel" Margin="0 2 0 2" />
            <RichTextLabel Name="SpeakerLabel" Margin="0 2 0 2" />
        </BoxContainer>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" Margin="8">
            <BoxContainer Name="ScheduleGrid" Orientation="Vertical" />
        </ScrollContainer>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" Margin="8">
            <BoxContainer Name="ActiveLawsList" Orientation="Vertical" />
        </ScrollContainer>
    </TabContainer>
</controls:FancyWindow>
