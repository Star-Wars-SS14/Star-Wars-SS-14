<Control xmlns="https://spacestation14.io" Margin="0 0 0 8">
    <PanelContainer StyleClasses="SWTermCard" />
    <BoxContainer Orientation="Vertical" Margin="10 8" SeparationOverride="6">
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Name="TaskName" StyleClasses="SWTermHeading" HorizontalExpand="True" ClipText="True" VAlign="Center" />
            <BoxContainer Name="RewardList" Orientation="Horizontal" SeparationOverride="4" />
        </BoxContainer>
        <RichTextLabel Name="TaskDescription" StyleClasses="SWTermText" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <PanelContainer StyleClasses="SWTermBarFrame" HorizontalExpand="True" VerticalAlignment="Center">
                <ProgressBar Name="TaskProgress" Margin="2" MinHeight="12" MinValue="0" MaxValue="1" />
            </PanelContainer>
            <Label Name="TaskPercent" StyleClasses="SWTermValue" MinWidth="48" Align="Right" VAlign="Center" />
            <PanelContainer Name="TaskDone" StyleClasses="SWTermDoneFrame" Visible="False" SetSize="22 22" VerticalAlignment="Center">
                <TextureRect TexturePath="/Textures/_SW/Interface/Misc/tick.png" ModulateSelfOverride="#5CB353"
                             Stretch="Scale" Margin="4" />
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</Control>
