<Control xmlns="https://spacestation14.io">
    <BoxContainer Orientation="Horizontal">
        <BoxContainer
            Margin="0 0 4 0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinSize="32 32"
            />
        <BoxContainer Margin="4 4 4 4" MaxWidth="200">
            <Label Name="CurrencyName"/>
        </BoxContainer>
        <BoxContainer Margin="4 4 4 4" MinWidth="100" MaxWidth="200">
            <LineEdit
                        Name="AmountEdit"
                        PlaceHolder="0"
                        Text="0"
                        HorizontalExpand="True">
            </LineEdit>
        </BoxContainer>
    </BoxContainer>
</Control>
