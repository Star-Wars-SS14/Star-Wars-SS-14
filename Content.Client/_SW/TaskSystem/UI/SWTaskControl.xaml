<Control xmlns="https://spacestation14.io">
    <BoxContainer Orientation="Horizontal">
        <BoxContainer
            Name="TaskContainer"
            HorizontalExpand="True"
            Margin="0"/>
        <BoxContainer VerticalExpand="True" HorizontalExpand="True" MaxWidth="100" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="20 20 20 20">
            <RichTextLabel Name="TaskName"></RichTextLabel>
        </BoxContainer>
        <BoxContainer VerticalExpand="True" HorizontalExpand="False" MaxWidth="300" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="20 20 20 20">
            <RichTextLabel Name="TaskDescription"></RichTextLabel>
        </BoxContainer>
        <BoxContainer VerticalExpand="False" HorizontalExpand="False" Margin="20 20 20 20" HorizontalAlignment="Center"
                VerticalAlignment="Center" MinWidth="100" MaxWidth="200">
            <RichTextLabel Name="TaskStatus"></RichTextLabel>
        </BoxContainer>
    </BoxContainer>
</Control>
