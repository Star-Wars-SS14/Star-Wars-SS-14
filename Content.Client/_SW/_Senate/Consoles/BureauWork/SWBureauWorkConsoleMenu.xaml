<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:senate="clr-namespace:Content.Client._SW._Senate"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Рабочая консоль бюро"
    MinSize="700 660">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="14 10" SeparationOverride="0">
                    <senate:SWConsoleSeal Margin="0 0 12 0" />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="2">
                        <Label Name="HeaderNetwork" Text="РЕСПУБЛИКА / ГОЛОНЕТ" />
                        <Label Name="HeaderTitle" HorizontalExpand="True" ClipText="True" />
                    </BoxContainer>
                    <Label Name="HeaderClock" Margin="12 0 0 0" VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Name="StatusStrip" Orientation="Horizontal" Margin="12 6" />
            <PanelContainer Name="TabBarPanel">
                <WrapContainer Name="TabBar" Margin="6 4" />
            </PanelContainer>
            <BoxContainer Name="ContentHost" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <ScrollContainer Name="DeskScroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="10">
                    <BoxContainer Name="DeskList" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="FleetScroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="10">
                    <BoxContainer Name="FleetList" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="OpsScroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="10">
                    <BoxContainer Name="OpsList" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="RequestsScroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="10">
                    <BoxContainer Name="RequestsList" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
