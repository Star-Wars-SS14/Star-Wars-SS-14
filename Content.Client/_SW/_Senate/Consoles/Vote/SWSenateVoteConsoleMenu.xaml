<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Консоль голосования Сената"
    MinSize="580 580">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="12 7">
                    <Label Name="HeaderTitle" HorizontalExpand="True" />
                    <PanelContainer Name="LiveDot" MinSize="9 9" VerticalAlignment="Center" />
                    <Label Name="HeaderClock" Margin="7 0 0 0" />
                </BoxContainer>
            </PanelContainer>
            <PanelContainer Name="TabBarPanel">
                <BoxContainer Name="TabBar" Orientation="Horizontal" Margin="6 4" />
            </PanelContainer>
            <BoxContainer Name="ContentHost" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <ScrollContainer Name="AgendaPanel" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="10">
                    <BoxContainer Name="AgendaList" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="CurrentPanel" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="10">
                    <BoxContainer Name="CurrentContent" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="FloorPanel" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="10">
                    <BoxContainer Name="FloorContent" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
