<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ministry="clr-namespace:Content.Client._SW._Senate.Consoles.MinistrySelect"
    Title="Назначение в исполнительную власть" MinSize="640 460" SetSize="1100 780">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <ministry:SWMinistryLayout HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                <PanelContainer Name="HeaderPanel"><BoxContainer Orientation="Horizontal" Margin="12 8" SeparationOverride="10">
                    <TextureRect Name="Seal" SetSize="30 30" Stretch="KeepAspectCentered" CanShrink="True" />
                    <Label Name="HeaderTitle" Text="СЕНАТ / НАЗНАЧЕНИЕ В ИСПОЛНИТЕЛЬНУЮ ВЛАСТЬ" ClipText="True" HorizontalExpand="True" VerticalAlignment="Center" />
                </BoxContainer></PanelContainer>
                <BoxContainer Orientation="Horizontal" Margin="8 0" SeparationOverride="6">
                    <Button Name="MinistriesTab" Text="Министерства" HorizontalExpand="True" />
                    <Button Name="DepartmentsTab" Text="Департаменты" HorizontalExpand="True" />
                    <Button Name="BureausTab" Text="Бюро" HorizontalExpand="True" />
                </BoxContainer>
            </BoxContainer>
            <ministry:SWMinistryColumns HorizontalExpand="True" VerticalExpand="True" Margin="8" Gap="10">
                <PanelContainer Name="ListPanel"><BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                    <Label Name="ListTitle" Text="ПОРТФЕЛИ РЕСПУБЛИКИ" />
                    <ScrollContainer Name="ListScroll" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="MinistryList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="5" />
                    </ScrollContainer>
                </BoxContainer></PanelContainer>
                <ScrollContainer Name="DetailScroll" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="Dossier" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10" />
                </ScrollContainer>
            </ministry:SWMinistryColumns>
            <PanelContainer Name="FooterPanel" Margin="8 0 8 8">
                <ministry:SWMinistryColumns Footer="True" Gap="12" Margin="10 8">
                    <BoxContainer Name="FooterText" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="3" />
                    <Button Name="ClaimButton" Text="Занять портфель" VerticalAlignment="Center" />
                </ministry:SWMinistryColumns>
            </PanelContainer>
        </ministry:SWMinistryLayout>
    </PanelContainer>
</controls:FancyWindow>
