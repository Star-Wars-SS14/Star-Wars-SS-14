<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="{Loc 'sw-task-console-title'}"
    MinSize="800 500"
    SetSize="800 500">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="{Loc 'sw-task-console-header-name'}" HorizontalExpand="True" Margin="20 20 20 20" HorizontalAlignment="Center"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="{Loc 'sw-task-console-header-description'}" HorizontalExpand="True" Margin="20 20 20 20" HorizontalAlignment="Center"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="{Loc 'sw-task-console-header-status'}" HorizontalExpand="True" Margin="20 20 20 20" MinWidth="200" HorizontalAlignment="Center"/>
            </BoxContainer>
        </BoxContainer>
        <PanelContainer VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer
                    Name="TaskList"
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    RectClipContent="True"
                    MinHeight="50">
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
