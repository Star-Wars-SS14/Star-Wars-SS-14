<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
            SetSize="300 150"
            MinSize="300 150"
            Title= "Обменный автомат">
    <BoxContainer Orientation="Vertical" Margin="5">
        <Label Text="Баланс" HorizontalAlignment="Center"/>
        <BoxContainer Orientation="Horizontal"
            SeparationOverride="4"
            Margin="20 20 20 20"
            HorizontalExpand="True">
            <BoxContainer Name="BalanceContainer" Orientation="Vertical" Margin="0">
            </BoxContainer>
            <BoxContainer Orientation="Vertical" Margin="0">
                <Button
                    Name="MoneyInButton"
                    HorizontalExpand="True"
                    Margin="0">
                    <Label Text="Внести" HorizontalExpand="True" />
                </Button>
                <Button
                    Name="MoneyOutButton"
                    HorizontalExpand="True"
                    Margin="0">
                    <Label Text="Вывести" HorizontalExpand="True" />
                </Button>
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" Margin="5">
            <BoxContainer Orientation="Horizontal" Margin="5">
                <OptionButton
                Name="CurrencyExchangeFrom"
                MinWidth="100"
                StyleClasses="ButtonSquare"/>
                <LineEdit
                Name="AmountEdit"
                PlaceHolder="{Loc 'lathe-menu-search-designs'}"
                HorizontalExpand="True">
                </LineEdit>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" Margin="5" MaxWidth="100">
                <Label Text="на" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" Margin="5">
                <OptionButton
               Name="CurrencyExchangeTo"
               MinWidth="100"
               StyleClasses="ButtonSquare"/>
                <Label Name="ResultAmountLabel" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </BoxContainer>
        </BoxContainer>
        <Button
            Name="ConfirmButton"
            HorizontalExpand="True"
            Margin="0">
            <Label Text="Перевести" HorizontalExpand="True" />
        </Button>
    </BoxContainer>
</controls:FancyWindow>
