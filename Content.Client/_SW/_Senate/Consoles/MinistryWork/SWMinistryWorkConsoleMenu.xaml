<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Рабочая консоль министерства"
    MinSize="640 600">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="12 7">
                    <Label Name="HeaderTitle" HorizontalExpand="True" />
                    <PanelContainer Name="LiveDot" MinSize="9 9" VerticalAlignment="Center" />
                    <Label Name="HeaderClock" Margin="7 0 0 0" />
                </BoxContainer>
            </PanelContainer>
            <PanelContainer Name="TabBarPanel">
                <BoxContainer Name="TabBar" Orientation="Horizontal" Margin="6 4" />
            </PanelContainer>
            <BoxContainer Name="ContentHost" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <ScrollContainer Name="OverviewPanel" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="10">
                    <BoxContainer Name="OverviewContent" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="RepublicPanel" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="10">
                    <BoxContainer Name="RepublicContent" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="RequestsPanel" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="10">
                    <BoxContainer Name="RequestsContent" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="CommandPanel" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="10">
                    <BoxContainer Name="CommandContent" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <ScrollContainer Name="FleetPanel" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="10">
                    <BoxContainer Name="FleetContent" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
