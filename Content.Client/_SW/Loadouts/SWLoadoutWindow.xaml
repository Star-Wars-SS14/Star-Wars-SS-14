<ui:SWTerminalWindow xmlns="https://spacestation14.io"
                     xmlns:ui="clr-namespace:Content.Client._SW.UserInterface"
                     MinSize="680 420"
                     SetSize="720 500"
                     Resizable="True">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <BoxContainer Name="Tabs" Orientation="Horizontal" SeparationOverride="2" HorizontalExpand="True" />
        </BoxContainer>

        <BoxContainer Name="NameBox" Orientation="Horizontal" SeparationOverride="8" Visible="False">
            <Label Name="NameLabel" StyleClasses="SWTermText" VAlign="Center" />
            <LineEdit Name="NameEdit" StyleClasses="SWTermField" HorizontalExpand="True" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="10" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True">
                <PanelContainer StyleClasses="SWTermCard" VerticalExpand="True">
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                        <BoxContainer Name="Rows" Orientation="Vertical" SeparationOverride="4" Margin="6" />
                    </ScrollContainer>
                </PanelContainer>
                <RichTextLabel Name="DetailLabel" StyleClasses="SWTermText" MinHeight="40" MaxWidth="460" HorizontalAlignment="Left" />
                <Label Name="SaveHintLabel" StyleClasses="SWTermText" />
            </BoxContainer>

            <BoxContainer Orientation="Vertical" SeparationOverride="6" SetWidth="180">
                <Label Name="PointsLabel" StyleClasses="SWTermCellWord" FontColorOverride="#D9A441" Align="Center" Visible="False" />
                <PanelContainer StyleClasses="SWTermCard" VerticalExpand="True">
                    <SpriteView Name="Preview" Scale="5 5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Label Name="TryOnLabel" StyleClasses="SWTermValue" Text="{Loc 'sw-loadout-try-on'}" Align="Center"
                           VerticalAlignment="Top" Margin="0 6" Visible="False" />
                </PanelContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Button Name="RotateLeft" Text="◀" StyleClasses="SWTermButtonSmall" HorizontalExpand="True" />
                    <Button Name="RotateRight" Text="▶" StyleClasses="SWTermButtonSmall" HorizontalExpand="True" />
                </BoxContainer>
                <Button Name="ResetButton" StyleClasses="SWTermButton" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</ui:SWTerminalWindow>
