<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="task"
    MinSize="550 450"
    SetSize="750 500">
    <BoxContainer Orientation="Vertical">
        <Label Text="tasвфыарkname" Name="TaskfName" HorizontalExpand="True" />
        <PanelContainer VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer
                    Name="TaskList"
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    RectClipContent="True"
                    MinHeight="50">
                        <Control>
                            <BoxContainer
                                Name="TaskContainer"
                                Margin="0 0 4 0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MinSize="32 32"
                                MinHeight="50"/>
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="10">
                                <Label Text="taskname" Name="TaskName" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="10">
                                <Label Text="TaskDescription" Name="TaskDescription" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="10">
                                <Label Text="TaskStatus" Name="TaskStatus" HorizontalExpand="True" />
                            </BoxContainer>
                        </Control>
                    </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
