<windows:CharacterWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:windows="clr-namespace:Content.Client.UserInterface.Systems.Character.Windows"
    Title="{Loc 'character-info-title'}"
    MinWidth="400"
    MinHeight="545">

    <BoxContainer Orientation="Vertical" HorizontalExpand="true" VerticalExpand="true">

        <Label Name="RoleType" 
               HorizontalExpand="true"
               VerticalAlignment="Top" 
               Margin="0 6 0 10"
               HorizontalAlignment="Center" 
               StyleClasses="LabelHeading" 
               Access="Public"/>

        <Control MinHeight="5"/>

        <RichTextLabel Name="RoleDescription" 
                       HorizontalExpand="true"
                       VerticalAlignment="Top" 
                       Margin="0 6 0 10"
                       StyleClasses="Tooltip" 
                       Access="Public"/>

        <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
            <SpriteView OverrideDirection="South" Scale="2 2" Name="SpriteView" Access="Public" SetSize="64 64"/>
            <BoxContainer Orientation="Vertical" VerticalAlignment="Top" HorizontalExpand="true">
                <Label Name="NameLabel" Access="Public" HorizontalExpand="true"/>
                <Label Name="SubText" 
                       VerticalAlignment="Top"
                       StyleClasses="LabelSubText"
                       Access="Public"
                       HorizontalExpand="true"/>
            </BoxContainer>
        </BoxContainer>

        <Control MinHeight="15"/>

        <Label Name="ObjectivesLabel" 
               Access="Public" 
               Text="{Loc 'character-info-objectives-label'}" 
               HorizontalAlignment="Center"
               HorizontalExpand="true"/>

        <BoxContainer Orientation="Vertical" Name="Objectives" Access="Public" HorizontalExpand="true"/>

        <Control VerticalExpand="true"/>

        <cc:Placeholder Name="RolePlaceholder" 
                        Access="Public" 
                        PlaceholderText="{Loc 'character-info-roles-antagonist-text'}"
                        HorizontalExpand="true"/>

    </BoxContainer>

</windows:CharacterWindow>