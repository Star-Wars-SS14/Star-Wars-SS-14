<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="turret"
    MinSize="550 450"
    SetSize="750 500">
    <BoxContainer Orientation="Horizontal">
        <RichTextLabel Text="aboba"></RichTextLabel>
        <PanelContainer VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer
                    Name="AllowedJobsList"
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    RectClipContent="True"
                    MinHeight="50">
                    <Control>
                        <BoxContainer VerticalExpand="True" HorizontalExpand="True" MaxWidth="100" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="20 20 20 20">
                            <RichTextLabel Text="aboba"></RichTextLabel>
                        </BoxContainer>
                    </Control>
                    
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
        <PanelContainer VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer
                    Name="DeniedJobsList"
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    RectClipContent="True"
                    MinHeight="50">
                    <Control>
                        <BoxContainer VerticalExpand="True" HorizontalExpand="True" MaxWidth="100" HorizontalAlignment="Center"
            VerticalAlignment="Center" Margin="20 20 20 20">
                            <RichTextLabel Text="aboba"></RichTextLabel>
                        </BoxContainer>
                    </Control>
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
