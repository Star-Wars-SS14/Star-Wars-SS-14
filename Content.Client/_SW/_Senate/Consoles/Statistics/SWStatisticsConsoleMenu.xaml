<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:senate="clr-namespace:Content.Client._SW._Senate"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Статистика Республики" SetSize="1100 760" MinSize="760 620">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="0">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="14 10" SeparationOverride="0">
                    <senate:SWConsoleSeal Margin="0 0 12 0" />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="2">
                        <Label Name="HeaderNetwork" Text="РЕСПУБЛИКА / ГОЛОНЕТ" />
                        <Label Name="HeaderTitle" Text="Аналитика Республики" ClipText="True" />
                    </BoxContainer>
                    <Label Name="HeaderClock" Margin="12 0 0 0" VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>
            <PanelContainer Name="TabBarPanel"><WrapContainer Name="TabBar" Margin="8 4" /></PanelContainer>
            <BoxContainer Name="ContentHost" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="GalaxyPanel" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="12" SeparationOverride="8" />
                <BoxContainer Name="CommoditiesPanel" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="12" />
                <ScrollContainer Name="RepublicPanel" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="16">
                    <BoxContainer Name="RepublicStats" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="12" />
                </ScrollContainer>
                <ScrollContainer Name="SectorsPanel" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="16">
                    <BoxContainer Name="SectorTable" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="12" />
                </ScrollContainer>
                <ScrollContainer Name="OperationsPanel" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="16">
                    <BoxContainer Name="OperationsContent" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <BoxContainer Name="CrisesPanel" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="16">
                    <BoxContainer Name="CrisesList" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="12" />
                </BoxContainer>
                <BoxContainer Name="LawsPanel" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="16">
                    <BoxContainer Name="LawsList" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
