sw-saber-forms-action = Lightsaber forms
sw-saber-forms-action-description = Choose a combat form for your lit single-bladed lightsaber.
sw-saber-forms-active = { $form } · Active
sw-saber-forms-unavailable = Hold a lit single-bladed lightsaber in your active hand.
sw-saber-forms-busy = Wait for your attack or guard to end before changing forms.

sw-saber-form-shii-cho-name = Shii-Cho
sw-saber-form-shii-cho-description = Broad slashes with the standard attack and guard timing.
sw-saber-form-makashi-name = Makashi
sw-saber-form-makashi-description = A narrow thrust. Recover faster from a riposte after parrying. Reflects fewer shots.
sw-saber-form-soresu-name = Soresu
sw-saber-form-soresu-description = A compact slash and a longer guard. Pressing attack lowers the guard. You can strike after a brief recovery.

ent-ActionSWSaberForms = { sw-saber-forms-action }
    .desc = { sw-saber-forms-action-description }
