<ui:SWTerminalWindow xmlns="https://spacestation14.io"
                     xmlns:ui="clr-namespace:Content.Client._SW.UserInterface"
                     SetSize="630 372"
                     MinSize="630 372"
                     Title="{Loc 'sw-exchange-title'}">
    <BoxContainer Orientation="Vertical" SeparationOverride="10">
        <Label Text="{Loc 'sw-exchange-balance'}" StyleClasses="SWTermHeading" />
        <Control>
            <PanelContainer StyleClasses="SWTermCard" />
            <BoxContainer Name="BalanceContainer" Orientation="Vertical" />
        </Control>
        <BoxContainer Orientation="Horizontal" SeparationOverride="12" Margin="16 0">
            <Button Name="MoneyInButton" Text="{Loc 'sw-exchange-deposit'}" StyleClasses="SWTermButton" HorizontalExpand="True" />
            <Button Name="MoneyOutButton" Text="{Loc 'sw-exchange-withdraw'}" StyleClasses="SWTermButton" HorizontalExpand="True" />
        </BoxContainer>
        <PanelContainer StyleClasses="SWTermSectionDivider" MinHeight="2" Margin="0 4" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <OptionButton Name="CurrencyExchangeFrom" StyleClasses="SWTermOption" PrefixMargin="False" MinWidth="226" />
            <LineEdit Name="AmountEdit" StyleClasses="SWTermField" PlaceHolder="{Loc 'sw-exchange-amount'}" HorizontalExpand="True" MinWidth="50" />
            <Label Text="{Loc 'sw-exchange-to'}" StyleClasses="SWTermText" VAlign="Center" />
            <OptionButton Name="CurrencyExchangeTo" StyleClasses="SWTermOption" PrefixMargin="False" MinWidth="226" />
            <Label Name="ResultAmountLabel" StyleClasses="SWTermMoney" Text="0" MinWidth="30" Align="Right" VAlign="Center" />
        </BoxContainer>
        <Button Name="ConfirmButton" Text="{Loc 'sw-exchange-confirm'}" StyleClasses="SWTermMainButtonMoney" MinHeight="38" Margin="0 4 0 0" />
    </BoxContainer>
</ui:SWTerminalWindow>
