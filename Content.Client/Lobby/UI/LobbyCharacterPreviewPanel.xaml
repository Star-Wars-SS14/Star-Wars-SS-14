<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <BoxContainer Name="VBox" Orientation="Vertical">
        <controls:NanoHeading Name="Header" Text="{Loc 'lobby-character-preview-panel-header'}">

        </controls:NanoHeading>
        <!-- #SW start: the picture beside the words, so that the chat keeps the height -->
        <BoxContainer Name="Loaded" Orientation="Horizontal" SeparationOverride="8"
                      Visible="False">
            <BoxContainer Name="ViewBox" Orientation="Horizontal" HorizontalAlignment="Center">

            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" HorizontalAlignment="Stretch" VerticalAlignment="Center" SeparationOverride="6">
                <BoxContainer Name="CharacterDetails" Orientation="Vertical" SeparationOverride="2" Visible="False">
                    <Label Name="CharacterName" StyleClasses="LabelHeading" ClipText="True"
                           HorizontalAlignment="Stretch" Align="Left" MouseFilter="Pass" />
                    <Label Name="PriorityJob" ClipText="True"
                           HorizontalAlignment="Stretch" Align="Left" MouseFilter="Pass" />
                </BoxContainer>
                <Button Name="CharacterSetup" Text="{Loc 'lobby-character-preview-panel-character-setup-button'}" />
            </BoxContainer>
        </BoxContainer>
        <!-- #SW end -->
        <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}"/>
    </BoxContainer>
</Control>
