<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Voting.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Консоль управления турелями"
    MinSize="550 450"
    SetSize="1000 750">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">        
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <Label Text="Разрешенные должности" HorizontalAlignment="Center"/>
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="20 20 20 20" Name="AllowFactionsList" HorizontalExpand="True">
                <controls:VSpacer/>
            </BoxContainer>
            <PanelContainer VerticalExpand="True" HorizontalExpand="True">
                <ScrollContainer MinSize="200 100" VerticalExpand="True"
                              VScrollEnabled="True" HScrollEnabled="False">
                    <BoxContainer
                        Name="AllowedJobsList"
                        Orientation="Vertical"
                        HorizontalExpand="True"
                        RectClipContent="True"
                        MinHeight="50">
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <Label Text="Запрещенные должности" HorizontalAlignment="Center"/>
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="20 20 20 20" Name="DisallowFactionsList" HorizontalExpand="True">
                <controls:VSpacer/>
            </BoxContainer>
            <PanelContainer VerticalExpand="True" HorizontalExpand="True">
                <ScrollContainer MinSize="200 100" VerticalExpand="True"
                              VScrollEnabled="True" HScrollEnabled="False">
                    <BoxContainer
                        Name="DisallowedJobsList"
                        Orientation="Vertical"
                        HorizontalExpand="True"
                        RectClipContent="True"
                        MinHeight="50">
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
