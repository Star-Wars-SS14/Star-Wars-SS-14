<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Выбор сектора"
    MinSize="480 480">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="12 7">
                    <Label Name="HeaderTitle" HorizontalExpand="True" />
                </BoxContainer>
            </PanelContainer>
            <Label Name="StatusLabel" Margin="12 8 12 6" />
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" Margin="8">
                <GridContainer Name="SectorGrid" Columns="2" HSeparationOverride="6" VSeparationOverride="6" />
            </ScrollContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
