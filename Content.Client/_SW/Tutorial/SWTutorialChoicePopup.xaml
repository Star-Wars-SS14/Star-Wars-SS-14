<Control xmlns="https://spacestation14.io"
         xmlns:parallax="clr-namespace:Content.Client.Parallax"
         VerticalExpand="True" HorizontalExpand="True"
         MouseFilter="Stop">
    <parallax:ParallaxControl SpeedX="20"/>
    <PanelContainer StyleClasses="SWTermWindow"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="560">
        <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="16">
            <Label Text="{Loc 'sw-tutorial-choice-question'}" StyleClasses="SWTermTitle" />
            <PanelContainer StyleClasses="SWTermAccentNeutral" MinHeight="3" />
            <Button Name="NewToGameButton"
                    Text="{Loc 'sw-tutorial-choice-new-to-game'}"
                    StyleClasses="SWTermMainButtonNeutral"
                    MinHeight="40" />
            <Button Name="NewToServerButton"
                    StyleClasses="SWTermButton"
                    MinHeight="40" />
            <Button Name="SkipButton"
                    StyleClasses="SWTermButton"
                    MinHeight="40" />
            <Label Text="{Loc 'sw-tutorial-choice-hint'}"
                   StyleClasses="SWTermText" />
        </BoxContainer>
    </PanelContainer>
</Control>
