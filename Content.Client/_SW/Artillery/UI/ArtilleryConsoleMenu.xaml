<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'comms-console-menu-call-artillery-title'}"
    MinSize="400 225">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="5">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Margin="5">
        <LineEdit Name="CoordsX" HorizontalExpand="True" MinHeight="5" MinWidth="10" MaxHeight="50" MaxWidth="100"/>
        <LineEdit Name="CoordsY" HorizontalExpand="True" MinHeight="5" MinWidth="10" MaxHeight="50" MaxWidth="100"/>
        <Button Name="ArtilleryButton" Text="{Loc 'comms-console-menu-call-artillery'}" StyleClasses="OpenLeft" Access="Public" />
        </BoxContainer>        
        <RichTextLabel Name="CountdownLabel" HorizontalExpand="True" MinHeight="5" MinWidth="10"/>
        <RichTextLabel Name="AttacksLeft" HorizontalExpand="True" MinHeight="5" MinWidth="10"/>
    </BoxContainer>
</controls:FancyWindow>
