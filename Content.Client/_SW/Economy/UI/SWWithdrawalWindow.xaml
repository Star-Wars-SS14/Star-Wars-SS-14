<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Окно вывода"
    MinSize="300 200"
    SetSize="300 400">
    <BoxContainer Orientation="Vertical">
        
        <BoxContainer Orientation="Vertical"
                      VerticalExpand="True"
                      Name="RequestsList">
        </BoxContainer>

        <Button
        Name="CloseWithdrawalButton"
        HorizontalExpand="True"
        Margin="0">
            <Label Text="Закрыть" HorizontalExpand="True" />
        </Button>
        
        <Button
        Name="ConfirmButton"
        HorizontalExpand="True"
        Margin="0">
            <Label Text="Ок" HorizontalExpand="True" />
        </Button>
        
    </BoxContainer>
</DefaultWindow>
