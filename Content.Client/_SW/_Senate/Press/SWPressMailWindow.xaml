<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:senate="clr-namespace:Content.Client._SW._Senate"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Обращения и запросы" MinSize="780 560">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10">
        <Label Name="Notice" Text="Письма видны только участникам до отдельной публикации." />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" MinWidth="250" MaxWidth="320" HorizontalExpand="True" VerticalExpand="True">
                <Button Name="NewMail" Text="Новое обращение" />
                <Label Text="Адресаты" Margin="0 6 0 2" />
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="Targets" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <Label Text="Моя переписка" Margin="0 6 0 2" />
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="Threads" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <Button Name="Refresh" Text="Обновить" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="12 0 0 0">
                <Label Name="Context" Text="Выберите адресата." />
                <LineEdit Name="Subject" PlaceHolder="Тема обращения" />
                <ScrollContainer HorizontalExpand="True" VerticalExpand="True" Margin="0 6">
                    <BoxContainer Name="Messages" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
                <Label Text="До 512 символов; не более 6 сообщений в переписке." />
                <senate:SWConsoleTextEdit Name="Body" PlaceHolder="Текст обращения или ответа" MinHeight="90" />
                <BoxContainer Orientation="Horizontal">
                    <Button Name="SendNew" Text="Отправить обращение" HorizontalExpand="True" />
                    <Button Name="Reply" Text="Ответить" HorizontalExpand="True" />
                    <Button Name="CopyDraft" Text="В черновик (до 1000)" HorizontalExpand="True" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
