<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:senate="clr-namespace:Content.Client._SW._Senate"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Информационная консоль Сената"
    SetSize="920 660"
    MinSize="560 560">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="14 10" SeparationOverride="0">
                    <senate:SWConsoleSeal Margin="0 0 12 0" />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="2">
                        <Label Name="HeaderNetwork" Text="РЕСПУБЛИКА / ГОЛОНЕТ" />
                        <Label Name="HeaderTitle" HorizontalExpand="True" ClipText="True" />
                    </BoxContainer>
                    <Label Name="HeaderClock" Margin="12 0 0 0" VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>
            <PanelContainer Name="TabBarPanel">
                <WrapContainer Name="TabBar" Margin="6 4" />
            </PanelContainer>
            <BoxContainer Name="ContentHost" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <ScrollContainer Name="SectorsPanel" HorizontalExpand="True" VerticalExpand="True" Margin="8">
                    <BoxContainer Name="SectorList" Orientation="Vertical" />
                </ScrollContainer>
                <ScrollContainer Name="LeadershipPanel" HorizontalExpand="True" VerticalExpand="True" Margin="8">
                    <BoxContainer Name="LeadershipList" Orientation="Vertical" />
                </ScrollContainer>
                <ScrollContainer Name="SchedulePanel" HorizontalExpand="True" VerticalExpand="True" Margin="8">
                    <BoxContainer Name="ScheduleGrid" Orientation="Vertical" />
                </ScrollContainer>
                <ScrollContainer Name="LawsPanel" HorizontalExpand="True" VerticalExpand="True" Margin="8">
                    <BoxContainer Name="ActiveLawsList" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
