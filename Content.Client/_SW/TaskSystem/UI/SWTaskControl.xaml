<Control xmlns="https://spacestation14.io">
    <BoxContainer Orientation="Horizontal">
        <BoxContainer
            Name="TaskContainer"
            Margin="0 0 4 0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinSize="32 32"
                />
        <BoxContainer VerticalExpand="True" HorizontalExpand="True" Margin="20 20 20 20">
            <RichTextLabel Name="TaskName"></RichTextLabel>
        </BoxContainer>
        <BoxContainer VerticalExpand="True" HorizontalExpand="True" Margin="20 20 20 20">
            <RichTextLabel Name="TaskDescription" > </RichTextLabel>
        </BoxContainer>
        <BoxContainer Margin="20 20 20 20" HorizontalExpand="True" MinWidth="200">
            <RichTextLabel Name="TaskStatus"> </RichTextLabel>
        </BoxContainer>
    </BoxContainer>
</Control>
