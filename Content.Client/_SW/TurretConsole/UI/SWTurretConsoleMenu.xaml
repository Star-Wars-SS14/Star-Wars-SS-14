<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="turret"
    MinSize="550 450"
    SetSize="750 500">
    <BoxContainer Orientation="Horizontal">

        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer MinSize="200 100" VerticalExpand="True"
                          VScrollEnabled="True" HScrollEnabled="False">
                <BoxContainer
                    Name="AllowedJobsList"
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    RectClipContent="True"
                    MinHeight="50">
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>

        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer MinSize="200 100" VerticalExpand="True"
                          VScrollEnabled="True" HScrollEnabled="False">
                <BoxContainer
                    Name="DisallowedJobsList"
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    RectClipContent="True"
                    MinHeight="50">
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
