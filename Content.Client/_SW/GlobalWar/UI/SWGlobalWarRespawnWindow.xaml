<ui:SWGlobalWarWindow xmlns="https://spacestation14.io"
                      xmlns:ui="clr-namespace:Content.Client._SW.GlobalWar.UI"
                      Title="{Loc 'sw-global-war-respawn-title'}" MinSize="430 240" SetSize="640 470">
    <BoxContainer Orientation="Vertical" SeparationOverride="0">
        <ui:SWGlobalWarBand Name="Scene" SetHeight="200">
            <BoxContainer Orientation="Vertical" SetWidth="380" Margin="0 14 12 0" HorizontalAlignment="Right" VerticalAlignment="Top" SeparationOverride="0">
                <ui:SWGlobalWarPlate HorizontalAlignment="Center">
                    <Label Name="Word" Margin="12 2" />
                </ui:SWGlobalWarPlate>
                <Label Name="Timer" Align="Center" />
            </BoxContainer>
            <ui:SWGlobalWarPlate HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 6 6 0">
                <Label Name="HelpMark" Text="?" Margin="6 0" StyleClasses="SWTermValue" MouseFilter="Stop" />
            </ui:SWGlobalWarPlate>
        </ui:SWGlobalWarBand>
        <PanelContainer StyleClasses="SWTermDivider" MinHeight="1" />
        <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="16 10">
            <RichTextLabel Name="Status" />
            <PanelContainer Name="CitizenCard">
                <BoxContainer SeparationOverride="12">
                    <TextureRect Name="CitizenArt" Stretch="KeepAspectCovered" SetSize="120 94" RectClipContent="True" />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="6" Margin="0 0 10 0">
                        <Label Name="CitizenTitle" Text="{Loc 'sw-global-war-respawn-citizen-title'}" />
                        <RichTextLabel Name="CitizenNote" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
            <ui:SWGlobalWarConsoleButton Name="Civilian" MinHeight="44" />
            <RichTextLabel Name="CivilianReason" Visible="False" />
            <PanelContainer Name="ForceStrip" Visible="False">
                <BoxContainer SeparationOverride="12">
                    <TextureRect Name="ForceArt" Stretch="KeepAspectCovered" SetSize="76 60" RectClipContent="True" />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="2">
                        <Label Name="ForceTitle" ClipText="True" />
                        <RichTextLabel Name="ForceNote" MaxWidth="280" />
                    </BoxContainer>
                    <ui:SWGlobalWarConsoleButton Name="Force" SetWidth="176" Margin="0 10 10 10" />
                </BoxContainer>
            </PanelContainer>
            <RichTextLabel Name="ForceReason" Visible="False" />
            <RichTextLabel Name="Result" Visible="False" />
        </BoxContainer>
    </BoxContainer>
</ui:SWGlobalWarWindow>
